# Sao chép thành .env và điền giá trị thật. KHÔNG commit .env.
PORT=4000

# MongoDB Atlas
MONGODB_URI="mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/snakegame?retryWrites=true&w=majority"

# Bí mật ký session JWT (production đổi chuỗi ngẫu nhiên dài)
AUTH_SECRET="dev-snake-secret-0c9f3a7b2e1d4c6a8f5b3d9e7c1a2b4d"

# Origin của frontend (cho CORS). Nhiều origin thì ngăn cách bởi dấu phẩy.
FRONTEND_URL="http://localhost:3000"

# Domain cookie (production, vd ".googlesnakemods.com" để web + api chia sẻ cookie). Dev để trống.
COOKIE_DOMAIN=

# SameSite cho session cookie: lax (mặc định, khi web + api cùng site)
# hoặc none (BẮT BUỘC khi web/api khác site, vd demo Vercel + Railway — kèm HTTPS).
COOKIE_SAMESITE=lax

# Email tài khoản sẽ được phong admin khi chạy: npm run seed:admin
ADMIN_EMAIL=

# Gửi email (đặt lại mật khẩu) qua Resend. Thiếu RESEND_API_KEY -> chỉ log link ra console.
RESEND_API_KEY=
# Địa chỉ gửi. Thử nghiệm dùng onboarding@resend.dev; production dùng domain đã verify ở Resend.
EMAIL_FROM="Snake <onboarding@resend.dev>"

# V3 — số bậc được thưởng mặc định khi chốt mùa giải (admin có thể override mỗi lần chốt).
REWARD_TIERS=3
